# Copiar este archivo como .env y completar los valores reales.

# PostgreSQL 18 (servicio postgresql-x64-18, puerto 5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_cafeteria
DB_USER=postgres
DB_PASSWORD=cambiar_aqui

# Fuente de video: índice de la cámara (0, 1, ...) o ruta a un archivo de video
VIDEO_FUENTE=0
# true: el monitoreo continuo arranca solo al iniciar el servidor
MONITOR_AUTOINICIO=false

# URL de la API FastAPI a la que el módulo de visión envía los eventos
API_URL=http://localhost:8000
