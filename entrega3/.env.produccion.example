# Configuración del SERVIDOR. Copiar como .env en la carpeta entrega3/ del servidor:
#     cp .env.produccion.example .env && nano .env
# (despliegue/desplegar.sh lo crea solo, con claves aleatorias, si no existe).
# Nunca subir el .env a GitHub.

# PostgreSQL (contenedor inventario-db)
DB_NAME=inventario_cafeteria
DB_USER=postgres
DB_PASSWORD=cambiar_por_una_clave_larga

# Login de la página
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar_por_una_clave_larga

# Firma de las cookies de sesión (texto aleatorio largo; cambiarlo cierra todas las sesiones)
SECRET_KEY=cambiar_por_texto_aleatorio
